# Environment Configuration for AURELIS Dental Studio
# Relational Database Connection (Default: SQLite file for zero-config persistence, or PostgreSQL / Supabase)
DATABASE_URL="file:./dev.db"

# Session Security & JWT Signing Key (Must be at least 32 characters in production)
JWT_SECRET="replace-with-a-secure-random-secret-key-for-production"

# Clinic Localization
CLINIC_TIMEZONE="Asia/Kolkata"
CLINIC_CURRENCY="INR"
